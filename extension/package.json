{
  "name": "unblocksyria-tester-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt build && wxt zip",
    "zip:firefox": "wxt build -b firefox && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/repack-firefox.ps1",
    "verify-classifier": "tsx scripts/verify-classifier.ts",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.3.7",
    "lucide-react": "^1.47.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "wxt": "^0.21.4"
  }
}
